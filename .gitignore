# 실행 중 생기는 진단 로그
debug_*.txt

# 사용자가 등록한 명령 (개인 설정) - 예시는 commands.example.json 참고
commands.json

# 화면 캡처 결과 (ㅡ자 자세)
captures/

# 트레이 앱 로그와 첫 실행 표시
logs/
.first_run_done

# 문서: docs에서는 md(와 md가 쓰는 이미지)만 올리고, 변환본(Word·PPT)은 올리지 않음
docs/**/*.docx
docs/**/*.pptx
# 문서 변환·생성 도구(빌드 스크립트)도 올리지 않음
docs/tools/
docs/**/build_*.js

# 테스트 산출물
clap_test_result_*.png

# Python
__pycache__/
*.pyc

# 가상환경
.venv/
venv/

# 비밀 정보 (키·토큰이 들어갈 수 있는 파일)
.env
.env.*

# 모델 파일·압축 파일 (용량이 크고, Whisper 모델은 첫 실행 때 자동으로 받음)
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.tflite
*.zip
*.7z

# 임시·로그
*.log

# 편집기
.vscode/

# 발표 자료 빌드 환경
node_modules/
